{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de alimentos de Mi Plan Saludable",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "source", "status", "foods"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "foods": {
      "type": "array",
      "items": { "$ref": "#/$defs/food" },
      "minItems": 1
    }
  },
  "$defs": {
    "food": {
      "type": "object",
      "required": ["id", "name", "unit", "recipeUnit", "nutrition", "purchase", "nutritionSource"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "unit": { "enum": ["g", "ml", "ud"], "description": "Unit used for pantry balances, stock movements, and purchase package contents." },
        "recipeUnit": { "enum": ["g", "ml", "ud"], "description": "Unit used to measure this food in recipe ingredients." },
        "nutrition": { "$ref": "#/$defs/nutrition" },
        "approximateEdibleWeight_g_per_unit": { "type": "number", "exclusiveMinimum": 0, "description": "Approximate edible grams per piece, used to convert between recipe grams and pantry units." },
        "purchase": { "$ref": "#/$defs/purchase" },
        "nutritionSource": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        { "properties": { "unit": { "const": "g" }, "recipeUnit": { "const": "g" } }, "required": ["unit", "recipeUnit"] },
        { "properties": { "unit": { "const": "ml" }, "recipeUnit": { "const": "ml" } }, "required": ["unit", "recipeUnit"] },
        { "properties": { "unit": { "const": "ud" }, "recipeUnit": { "const": "ud" } }, "required": ["unit", "recipeUnit"] },
        { "properties": { "unit": { "const": "ud" }, "recipeUnit": { "const": "g" } }, "required": ["unit", "recipeUnit", "approximateEdibleWeight_g_per_unit"] }
      ],
      "allOf": [
        {
          "if": { "properties": { "recipeUnit": { "const": "g" } }, "required": ["recipeUnit"] },
          "then": { "properties": { "nutrition": { "properties": { "basis": { "const": "per_100g" } }, "required": ["basis"] } } }
        },
        {
          "if": { "properties": { "recipeUnit": { "const": "ml" } }, "required": ["recipeUnit"] },
          "then": { "properties": { "nutrition": { "properties": { "basis": { "const": "per_100ml" } }, "required": ["basis"] } } }
        },
        {
          "if": { "properties": { "recipeUnit": { "const": "ud" } }, "required": ["recipeUnit"] },
          "then": {
            "anyOf": [
              { "properties": { "nutrition": { "properties": { "basis": { "const": "per_unit" } }, "required": ["basis"] } } },
              { "properties": { "nutrition": { "properties": { "basis": { "const": "per_100g" } }, "required": ["basis"] } }, "required": ["approximateEdibleWeight_g_per_unit"] }
            ]
          }
        }
      ]
    },
    "nutrition": {
      "type": "object",
      "required": ["basis", "kcal", "protein_g", "carbohydrates_g", "fat_g"],
      "additionalProperties": false,
      "properties": {
        "basis": { "enum": ["per_100g", "per_100ml", "per_unit"] },
        "kcal": { "type": "number", "minimum": 0 },
        "protein_g": { "type": "number", "minimum": 0 },
        "carbohydrates_g": { "type": "number", "minimum": 0 },
        "fat_g": { "type": "number", "minimum": 0 }
      }
    },
    "purchase": {
      "type": "object",
      "required": ["store", "section", "quantity", "unit", "label"],
      "additionalProperties": false,
      "properties": {
        "store": { "enum": ["mercadona", "fruteria"] },
        "section": { "type": "string", "minLength": 1 },
        "quantity": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["g", "ml", "ud"] },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
