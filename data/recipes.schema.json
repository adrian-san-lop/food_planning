{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de recetas de Mi Plan Saludable",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "source", "status", "recipes"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "recipes": {
      "type": "array",
      "items": { "$ref": "#/$defs/recipe" },
      "minItems": 1
    }
  },
  "$defs": {
    "recipe": {
      "type": "object",
      "required": ["id", "name", "mealType", "baseServings", "timeMinutes", "photoKey", "ingredients", "steps", "tip", "description"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "mealType": { "enum": ["desayuno", "media", "comida", "tarde", "cena"] },
        "baseServings": { "type": "number", "exclusiveMinimum": 0 },
        "timeMinutes": { "type": "integer", "minimum": 0 },
        "photoKey": { "type": "string", "minLength": 1 },
        "ingredients": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ingredient" } },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "tip": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "ingredient": {
      "type": "object",
      "required": ["foodId", "amount", "unit"],
      "additionalProperties": false,
      "properties": {
        "foodId": { "type": "string", "pattern": "^[a-z][a-zA-Z0-9_]*$" },
        "amount": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "enum": ["g", "ml", "ud"], "description": "Recipe measurement unit; must match the referenced food's recipeUnit." }
      }
    }
  }
}
